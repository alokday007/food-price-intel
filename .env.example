# Food Price Intelligence — environment variables.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (consumed by both Django and the db service) ---
POSTGRES_DB=foodpriceintel
POSTGRES_USER=foodpriceintel
POSTGRES_PASSWORD=change-me
# Use "db" (the compose service name) when running under docker-compose;
# use "localhost" when running Django directly against a local Postgres.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Production database (Render/Neon) ---
# When DATABASE_URL is set it takes precedence over the POSTGRES_* vars above.
# Leave it UNSET for local docker-compose dev.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Redis cache (optional) ---
# Use the "redis" service name under docker-compose; "localhost" otherwise.
# If UNSET (e.g. production, where Redis is dropped), the app falls back to an
# in-process LocMemCache and still boots + passes /healthz/.
REDIS_URL=redis://redis:6379/0
